#!/usr/bin/env bash

selected_dir=$(
{
    find ~/projects -mindepth 1 -maxdepth 1 -type d ! -name playground
    find ~/projects/playground -mindepth 1 -maxdepth 1 -type d
    find ~/.config -mindepth 1 -maxdepth 1 -type l -xtype d
    find ~/.dotfiles -maxdepth 0
} | while read -r dir; do
    dir="${dir#$HOME/}"
    echo "$dir"
    [[ -d "$dir/backend" ]] && echo "$dir/backend"
    [[ -d "$dir/frontend" ]] && echo "$dir/frontend"

done | fzf
)

if [[ -z "$selected_dir" ]]; then
    exit 0
fi

full_selected_dir="$home/${selected_dir}"
session_name="sessionizer_${selected_dir//[\/.]/_}"
base_index=1
if ! tmux has-session -t "=$session_name" 2>/dev/null; then
    tmux new-session -d -s "$session_name" -c "$selected_dir"
    tmux send-keys -t "$session_name:$base_index" "nvim ." Enter
    tmux new-window -d -t "$session_name" -c "$selected_dir"

    tmux select-window -t "$session_name:$base_index"
fi


if [[ -n "$TMUX" ]]; then
    tmux switch-client -t "$session_name"
else
    tmux attach -t "$session_name"
fi
