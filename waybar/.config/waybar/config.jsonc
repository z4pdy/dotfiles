{
    "position": "bottom",
    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "network",
        "bluetooth",
        "clock"
    ],
    "network": {
        "interface": "wlp7s0",
        "format-ethernet": "",
        "format-wifi": "{icon}",
        "format-linked": "󰤫",
        "format-disconnected": "󰤮",
        "format-disabled": "󰤯",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\nIP: {ipaddr}",
        "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}"
    },
    "bluetooth": {
        "format-disabled": "󰂭",
        "format-off": "󰂲",
        "format-on": "",
        "format-connected": "󰂱",
        "format-no-controller": "󰂭",
        "tooltip-format-connected": "{device_alias}"
    },
    "clock": {
        "format": "{:%H:%M  %d-%m-%Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "first-day-of-week": 2,
            "iso8601": true,
            "mode" : "month",
            "mode-mon-col" : 3,
            "on-click-right" : "mode",
            "format": {
                "months": "<span color='#61AFEF'><b>{}</b></span>",
                "weekdays": "<span color='#98C379'><b>{}</b></span>",
                "today": "<span color='#E06C75'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click": "mode"
        }
    }
}
